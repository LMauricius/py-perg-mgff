# A small language, written to exercise the Kate backend.

# How the generated syntax definition describes itself.
> name(Toy) section(Sources) extensions(*.toy) mimetype(text/x-toy)

# A named list of attributes, reused by the macros below.
d Classed > autoclass

t Lex (

    d Digit  = 0-9
    d Letter = Letter|_
    d AlNum  = Letter|Decimal_Number|_

    d Space = ( \_|\t )+
        > style(Normal)

    # Fixed words, which become a keyword list.
    d Keyword = l e t
              | i f
              | e l s e
              | w h i l e
        > style(Keyword)

    d Ident = Letter ( AlNum )*
        > Classed style(Variable)

    d Number = ( Digit )+ ( . ( Digit )+ )?
        > class(Literal) style(Float)

    d Comment = # ( Letter|Decimal_Number|\_|\t )*
        > autoclass style(Comment)

    # length-based: the two-character operators win over the one-character ones
    d Op = < =
         | > =
         | = =
         | +
         | -
         | *
         | =
        > style(Operator)

    d LParen = \(
        > style(Normal)

    d RParen = \)
        > style(Normal)

    # The starting production: the file is a list of tokens, tried in order.
    # A choice carries no whitespace around its separator, or the space would
    # split it into separate items.
    d File = ( (Space)/(Comment)/(Keyword)/(Number)/(Ident)/(Op)/(LParen)/(RParen) )*
)

t Parse (

    # A highlighter colours every character, so `Parse` names every token it
    # wants coloured — the ones a parser would skip among them. A context holds
    # what its place in the grammar reaches and nothing else.
    d Skipped = Space
              / Comment

    # The bracketed alternative is what Kate can reproduce: it nests and folds.
    d Atom = Number
           / Ident
           / Keyword
           / Skipped
           / \( Expr \)

    d Expr = Atom Op Expr
           / Atom

    d File = ( Expr )*
)
